# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# Restart `npm run dev` after changes.

# Cloudinary (server-side — do not use NEXT_PUBLIC_ for API key or secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: public cloud name for client-only display (legacy). Prefer CLOUDINARY_CLOUD_NAME above.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

JWT_SECRET=

DATABASE_URL=

GMAIL_USER=
GMAIL_PASS=

WEB3FORMS_ACCESS_KEY=

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
